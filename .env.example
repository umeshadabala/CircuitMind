# CircuitMind Configuration
# AI-Native Engineering IDE for Physical Systems

# LLM Provider Configuration
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:120b-cloud

# Optional Cloud API Keys (if using cloud providers)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Wokwi Simulator & CI CLI Configuration
# Get your token from: https://wokwi.com/dashboard/ci
# Never commit your real token to source control or expose to frontend JavaScript.
WOKWI_CLI_PATH=wokwi-cli
WOKWI_CLI_TOKEN=
WOKWI_TIMEOUT_SECONDS=15
